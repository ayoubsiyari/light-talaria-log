# Talaria-Log Level 2 SaaS — copy to `.env` (never commit secrets)

# --- API ---
API_PORT=8787
API_HOST=0.0.0.0
NODE_ENV=development
PUBLIC_API_URL=http://127.0.0.1:8787
CORS_ORIGIN=http://127.0.0.1:5173
SECURE_COOKIES=false
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=14

# --- Postgres ---
DATABASE_URL=postgres://talaria:talaria@127.0.0.1:5432/talaria

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (MinIO / S3) ---
# disk = local data/chunks (no MinIO required)
# s3   = MinIO or AWS S3
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=talaria-chunks
S3_ACCESS_KEY=talaria
S3_SECRET_KEY=talaria-secret
S3_FORCE_PATH_STYLE=true

# --- Quotas ---
QUOTA_DATASETS_PER_USER=50
QUOTA_IMPORT_BYTES_DAY=2147483648
QUOTA_BACKTEST_HOUR=30

# --- Seed ---
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=admin12345
SEED_DEMO=true

# --- Vite (optional) — when set, /api/v1 proxies to real API ---
# TALARIA_API_PROXY=http://127.0.0.1:8787
