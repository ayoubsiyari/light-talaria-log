{
  "name": "fast-chart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "High-performance candlestick chart with Hero UI and low memory usage",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:session": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test src/session/__tests__/tfSwitch.property.test.ts",
    "test:orders": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test src/orders/__tests__/*.test.ts",
    "test:analytics": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test src/analytics/__tests__/*.test.ts",
    "bench:analytics": "node --experimental-strip-types --import ./scripts/register-alias.mjs ./scripts/bench-analytics.mjs",
    "check:orders-determinism": "node ./scripts/check-orders-determinism.mjs",
    "saas:up": "docker compose up -d postgres redis minio createbuckets",
    "saas:down": "docker compose down",
    "saas:api": "npm --prefix services/api run dev",
    "saas:migrate": "npm --prefix services/api run migrate",
    "saas:seed": "npm --prefix services/api run seed",
    "saas:install": "npm --prefix services/api install",
    "saas:dev": "TALARIA_API_PROXY=http://127.0.0.1:8787 vite",
    "saas:stack": "docker compose up -d --build"
  },
  "dependencies": {
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "dukascopy-node": "^1.50.0",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
