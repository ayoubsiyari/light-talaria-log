# Talaria-Log — copy to `.env` and adjust. Never commit real secrets.

# --- SPA (Vite) ---
# VITE_API_BASE=
# VITE_REMOTE_DATASETS=1

# --- API (services/api + docker compose) ---
API_PORT=8787
API_HOST=0.0.0.0
NODE_ENV=development
PUBLIC_API_URL=http://127.0.0.1:8787

# Optional CDN / public object prefix for public_read chunk binaries.
# When set, GET …/chunks returns CDN URLs for public datasets (offloads API).
# Example: https://chunks.cdn.example.com
# CDN must map /datasets/{id}/{tf}/{n}.bin → origin or S3.
CDN_PUBLIC_BASE=

# Comma-separated SPA origins
CORS_ORIGIN=http://127.0.0.1:5173

# Production: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-32chars-minimum!!
SESSION_TTL_DAYS=14
SECURE_COOKIES=false

DATABASE_URL=postgres://talaria:talaria@127.0.0.1:5432/talaria
REDIS_URL=redis://127.0.0.1:6379

STORAGE_DRIVER=disk
# STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=talaria-chunks
S3_ACCESS_KEY=talaria
S3_SECRET_KEY=talaria-secret
S3_FORCE_PATH_STYLE=true

# Quotas
QUOTA_DATASETS_PER_USER=50
QUOTA_IMPORT_BYTES_DAY=2147483648
QUOTA_DOWNLOAD_BYTES_DAY=10737418240
QUOTA_BACKTEST_HOUR=30

# Abuse / concurrency guards
MAX_CHUNKS_PER_QUERY=24
MAX_CHUNK_BYTES=524288
RATE_LIMIT_GLOBAL_RPM=300
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_PUBLISH_RPM=60
RATE_LIMIT_CHUNK_RPM=240
RATE_LIMIT_JOBS_RPM=30

# Cache-Control (seconds)
CACHE_PUBLIC_CHUNK_MAX_AGE=86400
CACHE_PRIVATE_CHUNK_MAX_AGE=120
CACHE_META_MAX_AGE=30

# Admin bootstrap — set locally / on the server only. Never commit real values.
# Generate: openssl rand -base64 32
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO=true
